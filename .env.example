# Cursor API key used by the Cursor Cloud Agents LLM provider.
# Create one at https://cursor.com/dashboard/api
CURSOR_API_KEY=

# Kimi / Moonshot API key for the OpenAI-compatible provider.
KIMI_API_KEY=

# OpenRouter API key for OpenAI-compatible routed models.
OPENROUTER_API_KEY=

# Gemini uses one different key per agent. The application has seven agents;
# an eighth key is intentionally not configured or used.
GEMINI_DISCOVERY_API_KEY=
GEMINI_REQUIREMENTS_API_KEY=
GEMINI_ARCHITECTURE_API_KEY=
GEMINI_DATABASE_API_KEY=
GEMINI_API_API_KEY=
GEMINI_DEVOPS_API_KEY=
GEMINI_REVIEWER_API_KEY=

# Provider selection and model defaults.
# Supported: cursor, kimi, openrouter, gemini
LLM_PROVIDER=cursor
LLM_API_KEY=
LLM_MODEL=default
LLM_BASE_URL=https://api.cursor.com/v1
KIMI_BASE_URL=https://api.moonshot.cn/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.7-flash

# Provider behaviour
# LLM_POLL_TIMEOUT_S bounds each agent generation. Keep it tight: the workflow
# runs several dependency stages plus a review, so a long timeout multiplies
# wall-clock time on failures. Lower values fail fast instead of hanging.
LLM_REQUEST_TIMEOUT_S=120
LLM_MAX_TOKENS=8192
LLM_POLL_INTERVAL_S=1.0
LLM_POLL_TIMEOUT_S=300

# Workflow limits
STRUCTURED_OUTPUT_MAX_RETRIES=1
# The reviewer runs at most once; a single targeted regeneration round follows.
MAX_REVIEW_ROUNDS=1
# Each artifact is regenerated at most once per workflow.
MAX_ARTIFACT_REVISIONS=1
# Bounded retries for transient LLM/provider failures.
MAX_LLM_RETRIES=1

# Supabase production persistence and authentication.
# SUPABASE_ANON_KEY is public by design. SUPABASE_SERVICE_ROLE_KEY is strictly
# server-only and must never be referenced from public HTML/JavaScript.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated trusted browser origins. Set the production Vercel URL after
# the first deployment; localhost origins are added automatically for dev.
APP_ENV=development
FRONTEND_ORIGIN=
APP_BASE_URL=

# Local development may use SQLite without login. Production automatically
# enables Supabase Auth as soon as all three Supabase values above are present.
ALLOW_ANONYMOUS_LOCAL=true

# One API request always finishes before Vercel's 300-second Hobby limit.
REQUEST_DEADLINE_S=190
DAILY_PROJECT_LIMIT=5
DAILY_DISCOVERY_LIMIT=30
DAILY_GENERATION_STAGE_LIMIT=40
